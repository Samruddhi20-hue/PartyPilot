
# ==========================================
# PARTY PILOT - ENVIRONMENT CONFIGURATION
# ==========================================

# Flask Configuration
SECRET_KEY=replace_with_your_new_flask_secret
FLASK_ENV=development

# ==========================================
# SUPABASE PROJECT CONFIGURATION
# ==========================================

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Backend secret key - keep private
SUPABASE_SECRET_KEY=

# Compatibility variable for existing storage code
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWKS URL
SUPABASE_JWKS_URL=

# ==========================================
# SUPABASE POSTGRESQL DATABASE
# ==========================================

DATABASE_URL=

DB_USER=postgres
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_NAME=postgres

# ==========================================
# SUPABASE STORAGE
# ==========================================

SUPABASE_STORAGE_BUCKET=venue-images

# ==========================================
# FILE UPLOAD CONFIGURATION
# ==========================================

MAX_CONTENT_LENGTH=41943040
